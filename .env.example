# Generated by deploy.sh on first run if missing.
# chmod 600 on the server.

# --- Site (required, no defaults — set these before re-running deploy.sh) ---
GRAFANA_DOMAIN=grafana.example.com
GRAFANA_PUBLIC_DOMAIN=grafana-public.example.com
UMAMI_DOMAIN=umami.example.com
TELEMETRY_DOMAIN=telemetry.example.com
VERSION_DOMAIN=version.telemetry.example.com
LE_EMAIL=admin@example.com

# Captured automatically by deploy.sh after first deploy of the
# "bulwark-public" dashboard. Don't edit by hand.
GRAFANA_PUBLIC_DASHBOARD_TOKEN=

# --- Postgres ---
POSTGRES_PASSWORD=
POSTGRES_GRAFANA_PASSWORD=
POSTGRES_UMAMI_PASSWORD=
POSTGRES_DASHBOARD_PASSWORD=
POSTGRES_TELEMETRY_PASSWORD=
# Grafana's data sources log in with these read-only roles
# (postgres/grafana-read-only.sql). deploy.sh generates missing ones.
POSTGRES_GRAFANA_DASHBOARD_RO_PASSWORD=
POSTGRES_GRAFANA_UMAMI_RO_PASSWORD=
POSTGRES_GRAFANA_TELEMETRY_RO_PASSWORD=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=https://grafana.example.com
# Client secret of the authentik application bulwark-grafana (sign-in with
# Rathblume Login). Required: docker compose refuses to start without it.
GRAFANA_OIDC_SECRET=

# --- Umami ---
UMAMI_APP_SECRET=
UMAMI_ROOT_URL=https://umami.example.com

# --- GitHub collector ---
# A fine-grained token for the organisation with read-only access to
# Metadata, Contents and Administration (the traffic numbers need it),
# with an expiry.
GITHUB_TOKEN=
GITHUB_ORG=
COLLECTOR_INTERVAL_FAST_MS=900000      # 15 min  - stars/issues/traffic
COLLECTOR_INTERVAL_SLOW_MS=86400000    # 24 hour - LOC/commits

# --- Version server ---
# Repo to poll for releases. The version-server pulls
# https://api.github.com/repos/${VERSION_SERVER_REPO}/releases hourly.
VERSION_SERVER_REPO=bulwarkmail/webmail
# Optional GitHub token to lift the 60 req/h unauthenticated rate limit.
# Public repos work without one.
VERSION_SERVER_GITHUB_TOKEN=
