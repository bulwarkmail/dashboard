{
  "uid": "bulwark-relay",
  "title": "Bulwark / Relay",
  "tags": ["bulwark", "relay"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active subscriptions",
      "description": "Currently stored subscriptions, split by transport. FCM = mobile app, Web = PWA browser.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (transport) (relay_subscriptions_active)",
          "legendFormat": "{{transport}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pushes / hour",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(relay_pushes_received_total[1h]))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Push error rate (last 1h)",
      "description": "Outcomes other than 'ok' or 'unregistered' across both transports.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "—",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.05, "color": "yellow" },
              { "value": 0.2, "color": "red" }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(relay_pushes_forwarded_total{result!~\"ok|unregistered\"}[1h])) / clamp_min(sum(increase(relay_pushes_forwarded_total[1h])), 1)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Relay process uptime",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "time() - relay_process_start_time_seconds" }]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Pushes by outcome / transport (per minute)",
      "description": "Each bar is split by both transport (fcm / web) and outcome (ok / unregistered / http-4xx / http-5xx / fail).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": { "mode": "normal" },
            "spanNulls": true
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (transport, result) (increase(relay_pushes_forwarded_total[1m]))",
          "legendFormat": "{{transport}} / {{result}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP requests by route (per minute)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": { "mode": "normal" },
            "spanNulls": true
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (increase(relay_http_requests_total{route!=\"/metrics\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "FCM send latency (p50 / p95 / p99) — gaps mean no FCM calls in window",
      "description": "Computed from a 30-minute sliding window of histogram buckets. A flat 'no data' span means there were no FCM sends in the last 30 minutes; that's correct, not a bug.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 5, "spanNulls": 1800000 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(relay_fcm_send_duration_seconds_bucket[30m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(relay_fcm_send_duration_seconds_bucket[30m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(relay_fcm_send_duration_seconds_bucket[30m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Web Push send latency (p50 / p95 / p99) — gaps mean no Web Push calls in window",
      "description": "Latency of encrypted Web Push delivery to browser push services (FCM/autopush/Apple). Same caveat as FCM: gaps == idle, not broken.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 5, "spanNulls": 1800000 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(relay_webpush_send_duration_seconds_bucket[30m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(relay_webpush_send_duration_seconds_bucket[30m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(relay_webpush_send_duration_seconds_bucket[30m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "HTTP latency (p50 / p95) — push routes only",
      "description": "Healthcheck (/api/health), the landing page, and the catch-all are filtered out so the line tracks real push traffic. Latency only renders during minutes with traffic — gaps here just mean the relay was idle.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 5, "spanNulls": 1800000 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(relay_http_request_duration_seconds_bucket{route=~\"/api/push/.*\"}[30m])))",
          "legendFormat": "p50 (all push routes)"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(relay_http_request_duration_seconds_bucket{route=~\"/api/push/.*\"}[30m])))",
          "legendFormat": "p95 (all push routes)"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(relay_http_request_duration_seconds_bucket{route=~\"/api/push/.*\"}[30m])))",
          "legendFormat": "p95 {{route}}"
        }
      ]
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Subscription churn (per 5 min)",
      "description": "Registers and unregisters split by transport. Unregisters are also tagged with reason (client / fcm-unregistered / webpush-gone).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "spanNulls": true }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (transport) (increase(relay_subscriptions_registered_total[5m]))",
          "legendFormat": "registered ({{transport}})"
        },
        {
          "refId": "B",
          "expr": "sum by (transport, reason) (increase(relay_subscriptions_unregistered_total[5m]))",
          "legendFormat": "unregistered {{transport}} ({{reason}})"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Memory & event-loop lag",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 7 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "spanNulls": true } } },
      "targets": [
        {
          "refId": "A",
          "expr": "relay_process_resident_memory_bytes / 1024 / 1024",
          "legendFormat": "RSS MiB"
        },
        {
          "refId": "B",
          "expr": "relay_nodejs_eventloop_lag_p95_seconds * 1000",
          "legendFormat": "loop p95 ms"
        }
      ]
    }
  ]
}
