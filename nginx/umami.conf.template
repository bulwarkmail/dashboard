server {
    listen 80;
    listen [::]:80;
    server_name ${UMAMI_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${UMAMI_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${UMAMI_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${UMAMI_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Umami takes the visitor's address from X-Real-IP only (CLIENT_IP_HEADER
    # in docker-compose.yml); every location sets it, and X-Forwarded-For, to
    # the address of the connection.

    # The tracker script and the endpoint it reports to are always open.
    # Umami emits its own CORS for /api/send, so let it through unmodified.
    location = /script.js {
        proxy_pass http://127.0.0.1:3007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/send {
        proxy_pass http://127.0.0.1:3007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The app itself (login, dashboards, API) only once deploy.sh has made
    # sure Umami's default login is gone, which renders this with "yes".
    set $umami_app_open "${UMAMI_APP_OPEN}";

    location / {
        if ($umami_app_open != "yes") {
            return 404;
        }
        proxy_pass http://127.0.0.1:3007;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
