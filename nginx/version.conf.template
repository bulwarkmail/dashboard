server {
    listen 80;
    listen [::]:80;
    server_name ${VERSION_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${VERSION_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${VERSION_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${VERSION_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    # PRIVACY: same posture as the telemetry vhost. nginx logs nothing for
    # this vhost — no IPs, no User-Agents, no query strings (which would
    # otherwise reveal which version each instance is running). The version
    # server itself also does not log query strings.
    access_log off;
    error_log /dev/null crit;

    client_max_body_size 1k;

    location = / {
        proxy_pass http://127.0.0.1:3009/$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Don't forward client IPs — the version server should never see them.
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://127.0.0.1:3009/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        return 404;
    }
}
